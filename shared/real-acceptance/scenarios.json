{
  "schema_version": "diet-manager/real-acceptance-scenarios/v1",
  "description": "饮食管家 B 0.1.1 真实环境验收场景集。每个场景在独立会话中执行；input 是受测消息，setup 是按序回放的同一会话前置消息。database_assertions 是执行后对官方数据根 SQLite 的只读白名单断言（expect_delta 为相对本场景开始前的净增量，expect_count 为绝对计数）。",
  "scenarios": [
    {
      "id": "REAL-0.1.1-meal-single",
      "category": "meal",
      "title": "单食物餐食记录",
      "input": "早餐吃了一个苹果。",
      "expected_outcome_status": "committed_with_issues",
      "database_assertions": [
        { "table": "event_records", "where": { "event_type": "diet_meal" }, "expect_delta": 1 },
        { "table": "meal_items", "where": {}, "expect_delta": 1 }
      ]
    },
