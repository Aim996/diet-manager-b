{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diet-manager.local/schemas/event-and-amount/v1",
  "x-schema-version": "1.1.0",
  "title": "Diet Manager Event and Amount Schema v1",
  "$ref": "#/$defs/MealEvent",
  "$defs": {
    "DecimalString": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "OccurredTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "resolved_start",
        "resolved_end",
        "precision",
        "timezone",
        "resolution_basis",
        "resolution_anchor",
        "resolver_version"
      ],
      "properties": {
        "raw_text": { "type": ["string", "null"] },
        "resolved_start": { "type": ["string", "null"], "format": "date-time" },
        "resolved_end": { "type": ["string", "null"], "format": "date-time" },
        "resolved_occurred_at": { "type": ["string", "null"], "format": "date-time" },
        "precision": { "enum": ["exact", "date", "meal_period", "approximate", "unknown"] },
        "timezone": { "type": "string", "minLength": 1 },
        "resolution_basis": { "type": "string", "minLength": 1 },
        "resolution_anchor": { "type": "string", "format": "date-time" },
        "resolver_version": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "precision": { "const": "exact" } }, "required": ["precision"] },
          "then": { "required": ["resolved_occurred_at"] },
          "else": { "properties": { "resolved_occurred_at": { "type": "null" } } }
        }
      ]
    },
    "Amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "kind",
        "value",
        "min_value",
        "max_value",
        "unit_raw",
        "unit_normalized",
        "qualifier",
        "conversion_basis",
        "conversion_formula",
        "conversion_source",
        "evidence_kind"
      ],
      "properties": {
        "raw_text": { "type": ["string", "null"] },
        "kind": { "enum": ["exact", "approximate", "range", "vague", "missing"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "allOf": [{ "$ref": "#/$defs/DecimalString" }, { "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" }] }
          ]
        },
        "min_value": {
          "oneOf": [
            { "type": "null" },
            { "allOf": [{ "$ref": "#/$defs/DecimalString" }, { "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" }] }
          ]
        },
        "max_value": {
          "oneOf": [
            { "type": "null" },
            { "allOf": [{ "$ref": "#/$defs/DecimalString" }, { "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" }] }
          ]
        },
        "unit_raw": { "type": ["string", "null"] },
        "unit_normalized": { "type": ["string", "null"] },
        "qualifier": { "type": ["string", "null"] },
        "conversion_basis": { "type": ["string", "null"] },
        "conversion_formula": { "type": ["string", "null"] },
        "conversion_source": { "type": ["string", "null"] },
        "evidence_kind": { "enum": ["explicit_user", "deterministic_conversion", "bounded_estimate", "unknown"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["exact", "approximate"] } }, "required": ["kind"] },
          "then": {
            "properties": { "value": { "type": "string" }, "min_value": { "type": "null" }, "max_value": { "type": "null" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "range" } }, "required": ["kind"] },
          "then": {
            "properties": { "value": { "type": "null" }, "min_value": { "type": "string" }, "max_value": { "type": "string" } }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["vague", "missing"] } }, "required": ["kind"] },
          "then": {
            "properties": { "value": { "type": "null" }, "min_value": { "type": "null" }, "max_value": { "type": "null" } }
          }
        }
      ]
    },
    "EventEnvelope": {
      "type": "object",
      "required": [
        "event_id",
        "schema_version",
        "event_type",
        "fact_kind",
        "source_text",
        "source_message_id",
        "conversation_id",
        "received_at",
        "committed_at",
        "occurred_at_text",
        "occurred_time",
        "result_status",
        "lifecycle_status",
        "provenance_refs"
      ],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "schema_version": { "enum": ["1.0.0", "1.1.0"] },
        "event_type": {
          "enum": [
            "diet_meal",
            "diet_water",
            "nutrition_supplemented",
            "inventory_stocked",
            "inventory_gift_received",
            "inventory_opened",
            "inventory_consumed",
            "inventory_returned_to_stock",
            "inventory_returned_to_vendor",
            "inventory_gifted_out",
            "inventory_adjusted",
            "inventory_discarded",
            "inventory_depleted",
            "inventory_voided"
          ]
        },
        "fact_kind": { "const": "completed" },
        "source_text": { "type": "string", "minLength": 1 },
        "source_message_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 },
        "received_at": { "type": "string", "format": "date-time" },
        "committed_at": { "type": "string", "format": "date-time" },
        "occurred_at_text": { "type": ["string", "null"] },
        "occurred_time": { "$ref": "#/$defs/OccurredTime" },
        "result_status": { "const": "committed" },
        "lifecycle_status": { "enum": ["active", "superseded", "voided"] },
        "provenance_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "MealItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_order",
        "raw_name",
        "normalized_name",
        "item_type",
        "stated_amount",
        "nutrition_amount",
        "inventory_amount",
        "package_amount",
        "inventory_effect_intent",
        "nutrition_effect_intent",
        "quality_flags"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "item_order": { "type": "integer", "minimum": 0 },
        "raw_name": { "type": "string", "minLength": 1 },
        "normalized_name": { "type": "string", "minLength": 1 },
        "item_type": { "enum": ["single_food", "packaged_product", "dish", "composite_dish", "nutrition_drink"] },
        "stated_amount": { "$ref": "#/$defs/Amount" },
        "nutrition_amount": { "oneOf": [{ "$ref": "#/$defs/Amount" }, { "type": "null" }] },
        "inventory_amount": { "oneOf": [{ "$ref": "#/$defs/Amount" }, { "type": "null" }] },
        "package_amount": { "oneOf": [{ "$ref": "#/$defs/Amount" }, { "type": "null" }] },
        "inventory_effect_intent": { "enum": ["attempt_home_inventory", "skip_external", "skip_by_user", "unknown"] },
        "nutrition_effect_intent": { "enum": ["calculate", "skip_by_user", "unknown"] },
        "quality_flags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "MealEvent": {
      "allOf": [
        { "$ref": "#/$defs/EventEnvelope" },
        {
          "type": "object",
          "required": ["meal_id", "meal_slot", "meal_slot_source", "context", "items"],
          "properties": {
            "event_type": { "const": "diet_meal" },
            "meal_id": { "type": "string", "minLength": 1 },
            "meal_slot": { "enum": ["breakfast", "lunch", "dinner", "snack", "late_night", "unknown"] },
            "meal_slot_source": { "enum": ["explicit", "inferred_from_time", "unknown"] },
            "context": { "enum": ["home_default", "external_explicit", "delivery_explicit", "skip_inventory_explicit", "unknown"] },
            "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MealItem" } }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
