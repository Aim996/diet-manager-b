{
  "name": "diet-manager-b",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:b-fault": "vitest run tests/fault-matrix.test.ts --maxWorkers=1 --minWorkers=1 && node tests/b-slice-crash-harness.mjs",
    "test:b-slice-crash": "npm run build && node tests/b-slice-crash-harness.mjs",
    "test:progress-reservation-concurrency": "npm run build && node tests/progress-reservation-concurrency.mjs",
    "test:repository-concurrency": "npm run build && node tests/repository-concurrency.mjs",
    "admin:backup": "node dist/admin/cli.js backup",
    "admin:restore": "node dist/admin/cli.js restore",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-local.ps1",
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins build --check --root . --entry ./dist/index.js && openclaw plugins validate --root . --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "^1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.5.17",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
