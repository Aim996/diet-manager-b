{
  "policy_id": "diet-manager/decision-thresholds/v1",
  "policy_version": "1.0.0",
  "change_level": "L3",
  "product_write_route": "B",
  "route_selection_mode": "fixed_b_only",
  "score_based_selection": false,
  "candidate_rules": {
    "hard_conflict_fields": [
      "brand",
      "variant",
      "specification",
      "food_form",
      "confirmed_alias"
    ],
    "unique_remaining_count": 1,
    "similarity_rank_may_select": false,
    "confirmed_alias_allowed": true,
    "similarity_only_result": "needs_confirmation",
    "unresolved_hard_conflict_result": "needs_confirmation"
  },
  "quick_option_rules": {
    "min_options": 2,
    "max_options": 4,
    "requires_complete_safe_action": true,
    "requires_live_target_revision": true,
    "requires_safe_exit": true,
    "hidden_when_outside_range": true
  },
  "expiry_policy": {
    "reliable_source_rank": [
      "user_explicit_expiration",
      "product_label_expiration",
      "production_plus_explicit_shelf_life",
      "manufacturer_product_rule",
      "confirmed_same_product_rule"
    ],
    "opened_shelf_life_source_rank": [
      "user_explicit",
      "product_label",
      "manufacturer_product_rule",
      "confirmed_same_product_rule"
    ],
    "category_derived_expiration_enabled": false,
    "effective_expiration_rule": "min(package_expiration, opened_at_plus_explicit_opened_shelf_life)",
    "near_expiry_operator": "0 < remaining_hours <= threshold_hours",
    "threshold_unit": "hours",
    "missing_rule_result": "unknown",
    "safety_semantics": "reminder_only_not_edibility_or_safety",
    "near_expiry_rules": [
      {
        "rule_id": "prepared_refrigerated_opened",
        "category": "prepared_food",
        "storage_location": "refrigerated",
        "seal_status": "opened",
        "threshold_hours": 24
      },
      {
        "rule_id": "prepared_refrigerated_unopened",
        "category": "prepared_food",
        "storage_location": "refrigerated",
        "seal_status": "unopened",
        "threshold_hours": 48
      },
      {
        "rule_id": "perishable_refrigerated_opened",
        "category": "refrigerated_perishable",
        "storage_location": "refrigerated",
        "seal_status": "opened",
        "threshold_hours": 24
      },
      {
        "rule_id": "perishable_refrigerated_unopened",
        "category": "refrigerated_perishable",
        "storage_location": "refrigerated",
        "seal_status": "unopened",
        "threshold_hours": 72
      },
      {
        "rule_id": "frozen_opened",
        "category": "frozen_food",
        "storage_location": "frozen",
        "seal_status": "opened",
        "threshold_hours": 168
      },
      {
        "rule_id": "frozen_unopened",
        "category": "frozen_food",
        "storage_location": "frozen",
        "seal_status": "unopened",
        "threshold_hours": 168
      },
      {
        "rule_id": "shelf_stable_opened",
        "category": "shelf_stable",
        "storage_location": "ambient",
        "seal_status": "opened",
        "threshold_hours": 168
      },
      {
        "rule_id": "shelf_stable_unopened",
        "category": "shelf_stable",
        "storage_location": "ambient",
        "seal_status": "unopened",
        "threshold_hours": 336
      }
    ]
  },
  "template_policy": {
    "major_component_set_must_match": true,
    "absolute_tolerance_grams": 10,
    "relative_tolerance_ratio": "0.10",
    "amount_tolerance_operator": "difference <= max(absolute_tolerance_grams, baseline_grams * relative_tolerance_ratio)",
    "minor_component_categories": {
      "strict_composition": [],
      "seasoning_tolerant": [
        "minor_seasoning"
      ]
    },
    "system_estimates_count_as_confirmation": false,
    "confirmation_states": [
      {
        "explicit_confirmation_count": 1,
        "status": "candidate"
      },
      {
        "explicit_confirmation_count": 2,
        "status": "active"
      },
      {
        "explicit_confirmation_count": 3,
        "status": "stable"
      }
    ]
  },
  "rounding_policy": {
    "internal_rounding": "none",
    "display_quantity_decimal_places": 1,
    "display_quantity_mode": "round_half_up",
    "percentage_decimal_places": 0,
    "percentage_mode": "round_half_up",
    "ten_grid_segments": 10,
    "ten_grid_mode": "round_half_up_percentage_divided_by_10_clamped",
    "decimal_separator": "."
  },
